flowchart TD
    subgraph SIGNUP["At signup"]
        S1["Generate a random<br/>per-user data key (DEK)"]
        S2["Wrap it with a key derived<br/>from the user's password<br/>(AES-256-GCM)"]
        S3["Second wrap under a separate<br/>recovery key (server config)<br/>used only for password reset"]
        S1 --> S2
        S1 --> S3
    end

    subgraph LOGIN["At login"]
        L1["Password unwraps the DEK"]
        L2["DEK rides inside the user's<br/>signed session token,<br/>stored on their device"]
        L1 --> L2
    end

    subgraph REQUEST["On every request"]
        Q1["Token presents the DEK<br/>for that request only"]
        Q2["ORM encrypts and decrypts<br/>financial fields transparently"]
        Q1 --> Q2
    end

    DB[("Database stores<br/>ciphertext only.<br/>Operator cannot read<br/>financial data at rest")]

    SIGNUP --> LOGIN --> REQUEST --> DB

    style SIGNUP fill:#E9F4EC,stroke:#138A3C
    style LOGIN fill:#EFF6FF,stroke:#2563EB
    style REQUEST fill:#FEF3C7,stroke:#D97706
