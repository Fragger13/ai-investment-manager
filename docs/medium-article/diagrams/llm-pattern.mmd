flowchart TD
    REQ["User request<br/>(chat, plan, explanation)"]
    DET["Deterministic engine<br/>computes the full answer:<br/>numbers, cards, actions"]
    BASE["Complete baseline answer<br/>(correct but plain)"]
    ROUTER["Model router<br/>picks a model per task,<br/>checks cache first"]
    LLMOK{"LLM<br/>available?"}
    ENH["LLM rewrites the prose<br/>in Papa's voice<br/>(numbers stay untouched)"]
    POST["Post-processing<br/>Indian digit grouping,<br/>tone and safety checks"]
    FALL["Serve the baseline as is<br/>(no outage, no error)"]
    OUT["Response to user"]

    REQ --> DET --> BASE --> ROUTER --> LLMOK
    LLMOK -->|yes| ENH --> POST --> OUT
    LLMOK -->|"no / timeout / quota"| FALL --> OUT

    style DET fill:#E9F4EC,stroke:#138A3C
    style FALL fill:#FEF3C7,stroke:#D97706
    style ENH fill:#EFF6FF,stroke:#2563EB
